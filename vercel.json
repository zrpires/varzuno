{
 "$schema":"https://openapi.vercel.sh/vercel.json",
 "framework":null,
 "installCommand":"npm ci --ignore-scripts",
 "buildCommand":"npm run build",
 "outputDirectory":"dist",
 "functions":{"api/index.js":{"maxDuration":60}},
 "rewrites":[{"source":"/api/:route*","destination":"/api?route=:route*"}],
 "headers":[{"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},{"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"}]},{"source":"/(app|core|boot|client-api|local-store).js","headers":[{"key":"Cache-Control","value":"no-cache"}]}]
}
